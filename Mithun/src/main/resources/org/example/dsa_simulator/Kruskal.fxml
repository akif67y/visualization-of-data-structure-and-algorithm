<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="750.0" prefWidth="1000.0" spacing="15.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.dsa_simulator.graph.KruskalController">
    <stylesheets>
        <URL value="@Kruskal.css" />
    </stylesheets>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Button fx:id="returnButton" contentDisplay="GRAPHIC_ONLY" mnemonicParsing="false" onAction="#returnHome" styleClass="icon-button" text="Return">
                    <graphic>
                        <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@icons/Back.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Pane HBox.hgrow="ALWAYS" />
                <Label text="Kruskal's Algorithm Visualizer">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Pane HBox.hgrow="ALWAYS" />
                <Pane prefWidth="60.0" /> </children>
        </HBox>

        <HBox spacing="15.0" VBox.vgrow="ALWAYS">
            <children>
                <Pane fx:id="graphPane" onMouseClicked="#handleGraphPaneClick" HBox.hgrow="ALWAYS" />

                <VBox maxWidth="250.0" minWidth="250.0" spacing="15.0">
                    <children>
                        <VBox styleClass="control-pane" spacing="10.0">
                            <children>
                                <Label styleClass="section-title" text="Mode" />
                                <RadioButton fx:id="addNodeRadio" mnemonicParsing="false" selected="true" text="Add Nodes">
                                    <toggleGroup>
                                        <ToggleGroup fx:id="modeToggleGroup" />
                                    </toggleGroup>
                                </RadioButton>
                                <RadioButton fx:id="addEdgeRadio" mnemonicParsing="false" text="Add Edges" toggleGroup="$modeToggleGroup" />
                                <RadioButton fx:id="deleteRadio" mnemonicParsing="false" text="Delete Element" toggleGroup="$modeToggleGroup" />
                                <Button fx:id="deleteButton" maxWidth="1.7976931348623157E308" onAction="#handleDeleteSelectedAction" styleClass="secondary-button" text="Delete Selected" />
                            </children>
                        </VBox>
                        <VBox styleClass="control-pane" spacing="10.0">
                            <children>
                                <Label styleClass="section-title" text="Edge Weight" />
                                <TextField fx:id="edgeWeightField" promptText="Enter edge weight (e.g., 5)" />
                            </children>
                        </VBox>
                        <VBox styleClass="control-pane" spacing="10.0">
                            <children>
                                <Label styleClass="section-title" text="Animation Speed" />
                                <Slider fx:id="speedSlider" blockIncrement="50.0" majorTickUnit="500.0" max="2000.0" min="50.0" value="500.0" />
                            </children>
                        </VBox>
                        <VBox spacing="10.0">
                            <children>
                                <Button fx:id="runButton" maxWidth="1.7976931348623157E308" onAction="#handleRunButtonAction" prefHeight="45.0" styleClass="primary-button" text="Run Kruskal's" />
                                <Button fx:id="resetButton" maxWidth="1.7976931348623157E308" onAction="#handleResetButtonAction" prefHeight="40.0" styleClass="secondary-button" text="Reset Canvas" />
                            </children>
                        </VBox>
                        <VBox fx:id="mstResultBox" spacing="8.0" styleClass="control-pane" VBox.vgrow="ALWAYS">
                            <children>
                                <Label styleClass="section-title" text="MST Result" />
                                <Label fx:id="mstWeightLabel" text="Total Weight: N/A" />
                                <Label fx:id="mstEdgesLabel" text="Edges: N/A" wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>

        <VBox spacing="5.0">
            <children>
                <Label text="Log">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <TextArea fx:id="logArea" editable="false" prefHeight="120.0" wrapText="true" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </children>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
</VBox>