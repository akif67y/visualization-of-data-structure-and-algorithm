<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<!--
  Root container is a BorderPane.
  - The 'top' section now holds all controls in a multi-line format using a VBox.
  - The 'center' is for the tree visualization.
  - The right and bottom sections have been removed.
-->

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.dsa_simulator.bst.TryBST">
    <top>
        <!-- A VBox is used to stack the control bars vertically. -->
        <VBox>
            <children>
                <!-- First row: Core BST Operations -->
                <ToolBar prefHeight="40.0" prefWidth="850.0">
                    <items>
                        <Label text="Enter Value:" />
                        <TextField fx:id="valueTextField" promptText="e.g., 50" />
                        <Button fx:id="insertButton" mnemonicParsing="false" onAction="#insert" text="Insert " />
                        <Button fx:id="searchButton" mnemonicParsing="false" onAction="#searchNode" text="Search" />
                        <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#delete" text="Delete " />
                        <Button fx:id="clearButton" mnemonicParsing="false" onAction="#clear" text="Clear Tree" />
                        <Label text="Traversal:" />
                        <ComboBox fx:id="traversalTypeComboBox" prefWidth="150.0" promptText="Choose Type" />
                        <Button fx:id="traverseButton" alignment="TOP_RIGHT" mnemonicParsing="false" onAction="#performTraversal" text="Perform Traversal" />
                    </items>
                </ToolBar>
            </children>
        </VBox>
    </top>
    <center>
        <!-- This Pane is the main area where the Binary Search Tree would be visualized. -->
        <Pane fx:id="drawPane" prefHeight="532.0" prefWidth="854.0" style="-fx-background-color: #f4f4f4;" BorderPane.alignment="CENTER" />
    </center>
</BorderPane>
