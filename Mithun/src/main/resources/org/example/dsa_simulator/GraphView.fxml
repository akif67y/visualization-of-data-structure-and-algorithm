<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.effect.Glow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Add the fx:controller attribute to link this FXML to your controller class -->

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.dsa_simulator.graph.GraphController">
    <children>
        <!-- Left side panel for controls -->
        <VBox layoutX="14.0" layoutY="14.0" prefHeight="572.0" prefWidth="250.0" spacing="10.0" style="-fx-background-color: #4baac4;" AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="14.0" AnchorPane.topAnchor="14.0">
            <children>
            <Button fx:id="returnButton" mnemonicParsing="false" onAction="#returnToHome" style="-fx-background-radius: 5;" text="Return" />
                <Label style="-fx-background-color: #4baac4;" text="Graph Input">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <Label text="Enter edges, one per line (e.g., 1 2):" wrapText="true" />
                <!-- Add fx:id to the TextArea so the controller can access it -->
                <TextArea fx:id="edgeInputArea" prefHeight="400.0" prefWidth="200.0" promptText="1 2&#10;" />
                <!-- Add fx:id and onAction to the Button -->
                <Button fx:id="drawButton" mnemonicParsing="false" onAction="#handleDrawGraph" prefHeight="40.0" prefWidth="250.0" style="-fx-background-radius: 8;" text="Draw Graph">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
               <effect>
                  <Glow />
               </effect></Button>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
        <!-- Right side panel for drawing the graph -->
        <Pane fx:id="graphPane" layoutX="280.0" layoutY="14.0" prefHeight="572.0" prefWidth="606.0" style="-fx-background-color: white; -fx-border-color: lightgrey;" AnchorPane.bottomAnchor="14.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="14.0" />
    </children>
</AnchorPane>
