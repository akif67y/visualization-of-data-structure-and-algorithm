<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.dsa_simulator.sort.SelectionSortController">
    <children>
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Label text="Array:" />
                <TextField fx:id="arrayInput" prefWidth="400.0" promptText="Enter comma-separated numbers" />
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </HBox>

        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button fx:id="startButton" mnemonicParsing="false" onAction="#startSort" text="Start Sort" />
                <Button fx:id="pauseButton" mnemonicParsing="false" onAction="#pauseSort" text="Pause" />
                <Button fx:id="resumeButton" mnemonicParsing="false" onAction="#resumeSort" text="Resume" />
                <Button fx:id="nextStepButton" mnemonicParsing="false" onAction="#doNextStep" text="Next Step" />
                <Button fx:id="resetButton" mnemonicParsing="false" onAction="#resetSort" text="Reset" />
            </children>
            <padding>
                <Insets bottom="15.0" left="10.0" right="10.0" top="5.0" />
            </padding>
        </HBox>

        <Label fx:id="statusLabel" alignment="CENTER" maxWidth="1.7976931348623157E308" text="Enter an array and click 'Start'" textAlignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="5.0" />
            </padding>
        </Label>

        <Pane fx:id="arrayContainer" prefHeight="400.0" prefWidth="800.0" style="-fx-background-color: #f0f0f0; -fx-border-color: #cccccc; -fx-border-width: 1px;">
            <VBox.margin>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </VBox.margin>
        </Pane>
    </children>
</VBox>