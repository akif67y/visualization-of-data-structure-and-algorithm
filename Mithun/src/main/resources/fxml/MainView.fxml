<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.SortingController">
    <top>
        <VBox styleClass="header-section">
            <children>
                <Label styleClass="main-title" text="Algorithm &amp; Data  Simulator">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Label styleClass="subtitle" text="Sorting Algorithms Visualization">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
                <Separator />
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </top>
    <center>
        <VBox styleClass="content-section">
            <children>
                <HBox styleClass="controls-section">
                    <children>
                        <VBox styleClass="control-group">
                            <children>
                                <Label styleClass="control-label" text="Algorithm:">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <ComboBox fx:id="algorithmComboBox" prefHeight="25.0" prefWidth="170.0" styleClass="algorithm-combo" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <VBox styleClass="button-group">
                            <children>
                                <HBox spacing="10.0">
                                    <children>
                                        <Button fx:id="randomizeButton" onAction="#handleRandomize" styleClass="control-button, randomize-button" text="Randomize" />
                                        <Button fx:id="sortButton" onAction="#handleSort" styleClass="control-button, sort-button" text="Start Sort" />
                                        <Button fx:id="resetButton" onAction="#handleReset" styleClass="control-button, reset-button" text="Reset Colors" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
                    </padding>
                </HBox>
                <ScrollPane fitToHeight="true" fitToWidth="true" styleClass="visualization-container">
                    <content>
                        <VBox styleClass="bars-wrapper">
                            <children>
                                <HBox fx:id="barsContainer" alignment="BOTTOM_CENTER" styleClass="bars-container" />
                            </children>
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </center>
    <bottom>
        <VBox styleClass="footer-section">
            <children>
                <Separator />
                <HBox styleClass="status-bar">
                    <children>
                        <Label styleClass="status-label-title" text="Status: ">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <Label fx:id="statusLabel" styleClass="status-label" text="Ready">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="legend-title" text="Legend: ">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <HBox spacing="15.0" styleClass="legend">
                            <children>
                                <HBox spacing="3.0" styleClass="legend-item">
                                    <children>
                                        <Label styleClass="legend-color, legend-default" text="  " />
                                        <Label styleClass="legend-text" text="Unsorted" />
                                    </children>
                                </HBox>
                                <HBox spacing="3.0" styleClass="legend-item">
                                    <children>
                                        <Label styleClass="legend-color, legend-comparing" text="  " />
                                        <Label styleClass="legend-text" text="Comparing" />
                                    </children>
                                </HBox>
                                <HBox spacing="3.0" styleClass="legend-item">
                                    <children>
                                        <Label styleClass="legend-color, legend-swapping" text="  " />
                                        <Label styleClass="legend-text" text="Swapping" />
                                    </children>
                                </HBox>
                                <HBox spacing="3.0" styleClass="legend-item">
                                    <children>
                                        <Label styleClass="legend-color, legend-sorted" text="  " />
                                        <Label styleClass="legend-text" text="Sorted" />
                                    </children>
                                </HBox>
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                    </padding>
                </HBox>
            </children>
        </VBox>
    </bottom>
</BorderPane>
