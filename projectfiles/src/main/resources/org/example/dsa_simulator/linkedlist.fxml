<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="900.0" prefWidth="1600.0" style="-fx-background-color: linear-gradient(to bottom, #f0f2f5 0%, #e4e7eb 100%);" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.dsa_simulator.linkedlist.LinkedListController">
    <children>
        <!-- Control Panel -->
        <VBox alignment="TOP_CENTER" layoutX="18.4" layoutY="60.0" prefHeight="820.0" prefWidth="502.0" spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="60.0">
            <children>

                <!-- Title (within control panel) -->
                <Label text="Linked List Visualizer" textFill="#2d3748">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </Label>

                <!-- Size Display -->
                <Label fx:id="sizeLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Size: 0" textFill="#4a5568">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>

                <!-- Add Node Section -->
                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: linear-gradient(to bottom, #ffffff, #f7fafc); -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 1.5);">
                    <children>
                        <Label prefHeight="30.0" prefWidth="90.0" text="Add Node:" textFill="#2d3748">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="inputField" onAction="#addNode" prefWidth="150.0" promptText="Enter node value" style="-fx-background-color: #f8f9fa; -fx-border-color: #cbd5e0; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8; -fx-font-size: 13px; -fx-text-fill: #4a5568;" />
                        <Button fx:id="addButton" mnemonicParsing="false" onAction="#addNode" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: #38a169; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 3, 0, 0, 1);" text="Add Node" />
                        <Button fx:id="clearButton" mnemonicParsing="false" onAction="#clearAll" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: #e53e3e; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 3, 0, 0, 1);" text="Clear All" />
                    </children>
                    <padding>
                        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                    </padding>
                </HBox>

                <!-- Delete Node Section -->
                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: linear-gradient(to bottom, #ffffff, #f7fafc); -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 1.5);">
                    <children>
                        <!-- Corrected: prefWidth and prefHeight as direct attributes -->
                        <Label prefHeight="30.0" prefWidth="90.0" text="Delete Node:" textFill="#2d3748">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="deleteField" prefWidth="150.0" promptText="Value to delete" style="-fx-background-color: #f8f9fa; -fx-border-color: #cbd5e0; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8; -fx-font-size: 13px; -fx-text-fill: #4a5568;" />
                        <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#deleteNode" prefHeight="40.0" prefWidth="110.0" style="-fx-background-color: #dd6b20; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 3, 0, 0, 1);" text="Delete Node" />
                    </children>
                    <padding>
                        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                    </padding>
                </HBox>

                <!-- Insert Node Section -->
                <HBox alignment="CENTER_LEFT" prefHeight="70.0" prefWidth="480.0" spacing="10.0" style="-fx-background-color: linear-gradient(to bottom, #ffffff, #f7fafc); -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 1.5);">
                    <children>
                        <Label prefHeight="25.0" prefWidth="50.0" text="Insert" textFill="#2d3748">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="insertValueField" onAction="#insertNode" prefWidth="120.0" promptText="New value" style="-fx-background-color: #f8f9fa; -fx-border-color: #cbd5e0; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8; -fx-font-size: 13px; -fx-text-fill: #4a5568;" />
                        <Label prefHeight="25.0" prefWidth="50.0" text="After" textFill="#2d3748">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <TextField fx:id="insertPositionField" onAction="#insertNode" prefWidth="80.0" promptText="Position" style="-fx-background-color: #f8f9fa; -fx-border-color: #cbd5e0; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8; -fx-font-size: 13px; -fx-text-fill: #4a5568;" />
                        <Button fx:id="insertButton" mnemonicParsing="false" onAction="#insertNode" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #3182ce; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 3, 0, 0, 1);" text="Insert Node" />
                    </children>
                    <padding>
                        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                    </padding>
                </HBox>

                <!-- Swap Nodes Section -->
                <HBox alignment="CENTER_LEFT" prefHeight="70.0" prefWidth="480.0" spacing="10.0" style="-fx-background-color: linear-gradient(to bottom, #ffffff, #f7fafc); -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 1.5);">
                    <children>
                        <Label prefHeight="25.0" prefWidth="50.0" text="Swap" textFill="#2d3748">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="swapField1" prefWidth="100.0" promptText="Pos 1" style="-fx-background-color: #f8f9fa; -fx-border-color: #cbd5e0; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8; -fx-font-size: 13px; -fx-text-fill: #4a5568;" />
                        <Label prefHeight="25.0" prefWidth="20.0" text="↔" textFill="#2d3748">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <TextField fx:id="swapField2" prefWidth="100.0" promptText="Pos 2" style="-fx-background-color: #f8f9fa; -fx-border-color: #cbd5e0; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8; -fx-font-size: 13px; -fx-text-fill: #4a5568;" />
                        <Button fx:id="swapButton" mnemonicParsing="false" onAction="#swapNodes" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #805ad5; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 3, 0, 0, 1);" text="Swap Nodes" />
                    </children>
                    <padding>
                        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                    </padding>
                </HBox>
                <Pane VBox.vgrow="ALWAYS" /> <!-- Spacer to push controls up -->
            </children>
            <padding>
                <Insets top="10.0" />
            </padding>
        </VBox>

        <!-- Drawing Area -->
        <Pane fx:id="drawingPane" layoutX="530.0" layoutY="60.0" prefHeight="820.0" prefWidth="1050.0" style="-fx-background-color: white; -fx-border-color: #cbd5e0; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 1.5);" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="530.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="60.0" />
      <Button contentDisplay="GRAPHIC_ONLY" layoutX="18.0" layoutY="14.0" mnemonicParsing="false" onAction="#returnHome" prefHeight="32.0" prefWidth="56.0" style="-fx-background-color: transparent;" text="Button">
         <graphic>
            <ImageView fitHeight="36.0" fitWidth="29.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@icons/Back.png" />
               </image>
            </ImageView>
         </graphic></Button>

        <!-- Title inside Drawing Area (Optional visual element) -->
        <!-- <Label layoutX="550.0" layoutY="20.0" text="Linked List Visualization" textFill="#343a40" AnchorPane.leftAnchor="550.0" AnchorPane.topAnchor="20.0">
              <font>
                  <Font name="System Bold" size="20.0" />
              </font>
          </Label> -->

    </children>
</AnchorPane>
