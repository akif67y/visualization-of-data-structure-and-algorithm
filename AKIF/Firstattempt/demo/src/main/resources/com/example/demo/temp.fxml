<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.tempcontroller">
    <children>
        <!-- Title -->
        <Label layoutX="300.0" layoutY="30.0" text="Stack Visualizer" textFill="WHITE">
            <font>
                <Font name="System Bold" size="32.0" />
            </font>
        </Label>

        <!-- Control Panel -->
        <VBox layoutX="50.0" layoutY="100.0" prefHeight="400.0" prefWidth="300.0" spacing="25.0" style="-fx-background-color: rgba(255, 255, 255, 0.1); -fx-background-radius: 20; -fx-padding: 30;">
            <children>
                <!-- Input Section -->
                <VBox spacing="10.0">
                    <children>
                        <Label text="Enter Value:" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <TextField fx:id="inputField" onKeyPressed="#handleTextFieldKeyPressed" prefHeight="45.0" promptText="Input a Number" style="-fx-background-color: rgba(255, 255, 255, 0.9); -fx-background-radius: 10; -fx-padding: 0 15; -fx-font-size: 14px; -fx-border-color: transparent; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </TextField>
                    </children>
                </VBox>

                <!-- Buttons Section -->
                <VBox spacing="15.0">
                    <children>
                        <Button fx:id="pushbutton" mnemonicParsing="false" onAction="#onAddClicked" prefHeight="50.0" prefWidth="240.0" style="-fx-background-color: #4CAF50; -fx-background-radius: 15; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 8, 0, 0, 3); -fx-cursor: hand;" text="🔼 PUSH">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Button>

                        <Button mnemonicParsing="false" onAction="#poppedCalled" prefHeight="50.0" prefWidth="240.0" style="-fx-background-color: #f44336; -fx-background-radius: 15; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 8, 0, 0, 3); -fx-cursor: hand;" text="🔽 POP">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Button>
                    </children>
                </VBox>

                <!-- Stack Info -->
                <VBox spacing="10.0">
                    <children>
                        <Label text="Stack Operations:" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <Label text="• PUSH: Add element to top" textFill="rgba(255, 255, 255, 0.8)">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                        <Label text="• POP: Remove top element" textFill="rgba(255, 255, 255, 0.8)">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </VBox>

        <!-- Stack Visualization Area -->
        <VBox layoutX="400.0" layoutY="100.0" prefHeight="400.0" prefWidth="350.0" style="-fx-background-color: rgba(255, 255, 255, 0.15); -fx-background-radius: 20; -fx-padding: 20;">
            <children>
                <!-- Stack Title -->
                <HBox alignment="CENTER" prefHeight="50.0">
                    <children>
                        <Label text="Stack Visualization" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <!-- Stack Container -->
                <VBox alignment="BOTTOM_CENTER" prefHeight="330.0" prefWidth="310.0" style="-fx-background-color: rgba(255, 255, 255, 0.1); -fx-background-radius: 15; -fx-padding: 15;">
                    <children>
                        <!-- Stack Base -->
                        <Label text="── STACK BASE ──" textFill="rgba(255, 255, 255, 0.6)">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>

                        <!-- Dynamic Stack Elements Container -->
                        <VBox fx:id="buttonContainer" alignment="BOTTOM_CENTER" spacing="5.0">
                            <VBox.margin>
                                <Insets bottom="10.0" top="10.0" />
                            </VBox.margin>
                        </VBox>

                        <!-- Stack Top Indicator -->
                        <Label text="↑ TOP" textFill="#FFD700">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </VBox>

        <!-- Footer -->
        <Label layoutX="250.0" layoutY="550.0" text="Press Enter in input field to quickly add elements" textFill="rgba(255, 255, 255, 0.7)">
            <font>
                <Font size="12.0" />
            </font>
        </Label>
    </children>
</AnchorPane>
