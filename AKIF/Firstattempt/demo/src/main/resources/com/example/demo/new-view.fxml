<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo.MainController"
            prefWidth="1500.0" prefHeight="800.0">

   <children>
      <VBox layoutX="591.0" layoutY="181.0"
            prefWidth="318.0" prefHeight="438.0"
            spacing="30" alignment="CENTER">
         <children>
            <Button text="LinkedList"
                    onAction="#LinkedListButtonClick"
                    prefWidth="200.0" prefHeight="60.0"
                    style="-fx-background-color: #009688; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 8, 0, 0, 2);">
               <padding>
                  <Insets top="10" bottom="10" left="20" right="20"/>
               </padding>
            </Button>
            <Button text="Queue"
                    onAction="#QueueButtonClick"
                    prefWidth="200.0" prefHeight="60.0"
                    style="-fx-background-color: #009688; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 8, 0, 0, 2);">
               <padding>
                  <Insets top="10" bottom="10" left="20" right="20"/>
               </padding>
            </Button>
            <Button text="STACK"
                    onAction="#StackButtonClick"
                    prefWidth="200.0" prefHeight="60.0"
                    style="-fx-background-color: #009688; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 8, 0, 0, 2);">
               <padding>
                  <Insets top="10" bottom="10" left="20" right="20"/>
               </padding>
            </Button>
         </children>
      </VBox>
   </children>
</AnchorPane>
