<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1500.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.dynamicProgramming.knapsack">

    <!-- Background -->
    <children>
        <Pane prefHeight="0.0" prefWidth="1500.0" style="-fx-background-color: #f8f9fa;">
            <children>

                <!-- Header -->
                <Label layoutX="131.0" layoutY="34.0" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="0/1 Knapsack Problem (DP)">
                    <font>
                        <Font name="Segoe UI" />
                    </font>
                </Label>

                <!-- Weight Input -->
                <Label layoutX="50.0" layoutY="80.0" style="-fx-font-size: 14; -fx-text-fill: #34495e;" text="Weights (comma-separated):" />
                <TextField fx:id="weightsField" layoutX="230.0" layoutY="76.0" onAction="#onWeightsEnter" prefWidth="300.0" promptText="e.g., 2,3,4,5">
                    <style>
                        -fx-pref-height: 35px;
                        -fx-font-size: 14px;
                        -fx-background-radius: 8;
                        -fx-border-radius: 8;
                        -fx-border-color: #bdc3c7;
                        -fx-padding: 5 10;
                    </style>
                </TextField>

                <!-- Values Input -->
                <Label layoutX="50.0" layoutY="120.0" style="-fx-font-size: 14; -fx-text-fill: #34495e;" text="Values (comma-separated):" />
                <TextField fx:id="valuesField" layoutX="230.0" layoutY="116.0" onAction="#onValuesEnter" prefWidth="300.0" promptText="e.g., 3,4,5,6">
                    <style>
                        -fx-pref-height: 35px;
                        -fx-font-size: 14px;
                        -fx-background-radius: 8;
                        -fx-border-radius: 8;
                        -fx-border-color: #bdc3c7;
                        -fx-padding: 5 10;
                    </style>
                </TextField>

                <!-- Capacity Input -->
                <Label layoutX="50.0" layoutY="160.0" style="-fx-font-size: 14; -fx-text-fill: #34495e;" text="Knapsack Capacity:" />
                <TextField fx:id="capacityField" layoutX="230.0" layoutY="156.0" onAction="#onCapacityEnter" prefWidth="100.0" promptText="e.g., 5">
                    <style>
                        -fx-pref-height: 35px;
                        -fx-font-size: 14px;
                        -fx-background-radius: 8;
                        -fx-border-radius: 8;
                        -fx-border-color: #bdc3c7;
                        -fx-padding: 5 10;
                    </style>
                </TextField>

                <!-- Action Buttons -->
                <Button layoutX="50.0" layoutY="200.0" onAction="#onGenerate" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 8;" text="Generate DP Table">
                    <font>
                        <Font name="Segoe UI" />
                    </font>
                </Button>

                <Button layoutX="220.0" layoutY="200.0" onAction="#extractItems" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 8;" text="Extract Items">
                    <font>
                        <Font name="Segoe UI" />
                    </font>
                </Button>

                <!-- Results Panel -->
                <Label layoutX="749.0" layoutY="30.0" prefHeight="38.0" prefWidth="150.0" style="-fx-font-size: 14; -fx-text-fill: #2c3e50;" text="Max Value:" />

                <Label fx:id="resultLabel" layoutX="860.0" layoutY="30.0" prefHeight="38.0" prefWidth="139.0" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #e74c3c; -fx-padding: 5 10; -fx-background-color: #ecf0f1; -fx-background-radius: 6; -fx-border-color: #bdc3c7; -fx-border-width: 1;" />

                <Label layoutX="828.0" layoutY="81.0" prefHeight="38.0" prefWidth="100.0" style="-fx-font-size: 14; -fx-text-fill: #2c3e50;" text="Items Picked:" />

                <Label fx:id="pickedItems" layoutX="749.0" layoutY="122.0" prefHeight="138.0" prefWidth="300.0" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #27ae60; -fx-padding: 5 10; -fx-background-color: #ecf0f1; -fx-background-radius: 6; -fx-border-color: #bdc3c7; -fx-border-width: 1;" />
            <Button layoutX="14.0" layoutY="14.0" mnemonicParsing="false" text="Button" />

            </children>
        </Pane>

        <!-- Table Title -->
        <Label layoutX="50.0" layoutY="250.0" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="DP Table: Value vs. Weight Capacity" />

        <!-- Drawing Pane -->
        <Pane fx:id="drawingPane" layoutX="50.0" layoutY="273.0" prefHeight="537.0" prefWidth="1362.0" style="-fx-background-color: #ffffff; -fx-border-color: #bdc3c7; -fx-border-width: 2; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 0);" />

          <Label fx:id="status" layoutX="1116.0" layoutY="138.0" prefHeight="72.0" prefWidth="291.0" style="-fx-font-size: 13; -fx-text-fill: #7f8c8d; -fx-padding: 10; -fx-background-color: #ffffff; -fx-border-color: #dce0e4; -fx-border-width: 1; -fx-background-radius: 6;" text="Ready to compute..." wrapText="true" />

          <Label layoutX="1150.0" layoutY="88.0" prefHeight="35.0" prefWidth="120.0" style="-fx-font-size: 14; -fx-text-fill: #2c3e50;" text="Status:" />

    </children>
</AnchorPane>
