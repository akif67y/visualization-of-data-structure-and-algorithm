<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>


<AnchorPane prefHeight="800.0" prefWidth="1500.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.LinkedListController">
   <children>
        <Pane fx:id="drawingPane" layoutX="14.0" layoutY="107.0" prefHeight="679.0" prefWidth="1482.0" style="-fx-background-color: #f0f0f0; -fx-border-color: #cccccc; -fx-border-width: 1;" />
        <HBox alignment="CENTER" layoutX="14.0" layoutY="39.0" spacing="10.0">
            <children>
                <TextField fx:id="inputField" prefWidth="200.0" promptText="Enter value" />
                <Button fx:id="addButton" mnemonicParsing="false" text="Add Node" />
                <Button fx:id="clearButton" mnemonicParsing="false" text="Clear All" />
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </HBox>
   </children>
</AnchorPane>
