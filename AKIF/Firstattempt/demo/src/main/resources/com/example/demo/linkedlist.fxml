<AnchorPane prefHeight="900.0" prefWidth="1600.0" style="-fx-background-color: linear-gradient(to bottom, #f8f9fa 0%, #e9ecef 100%);" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.linkedlist.LinkedListController">
    <children>
