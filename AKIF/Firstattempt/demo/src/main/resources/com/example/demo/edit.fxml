<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1500.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.dynamicProgramming.editdistance">

    <!-- Background -->
    <children>
        <Pane prefHeight="800" prefWidth="1500" style="-fx-background-color: #f8f9fa;">
            <children>

                <!-- Header -->
                <Label layoutX="50.0" layoutY="30.0" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Sequence Alignment">
                    <font>
                        <Font name="Segoe UI" />
                    </font>
                </Label>

                <!-- String 1 Input -->
                <Label layoutX="50.0" layoutY="80.0" style="-fx-font-size: 14; -fx-text-fill: #34495e;" text="String 1:" />
                <TextField fx:id="s1" layoutX="120.0" layoutY="76.0" onAction="#onString1Enter" prefWidth="250.0" promptText="Enter first string and press Enter">
                    <style>
                        -fx-pref-height: 35px;
                        -fx-font-size: 14px;
                        -fx-background-radius: 8;
                        -fx-border-radius: 8;
                        -fx-border-color: #bdc3c7;
                        -fx-padding: 5 10;
                    </style>
                </TextField>

                <!-- String 2 Input -->
                <Label layoutX="50.0" layoutY="120.0" style="-fx-font-size: 14; -fx-text-fill: #34495e;" text="String 2:" />
                <TextField fx:id="s2" layoutX="120.0" layoutY="116.0" onAction="#onString2Enter" prefWidth="250.0" promptText="Enter second string and press Enter">
                    <style>
                        -fx-pref-height: 35px;
                        -fx-font-size: 14px;
                        -fx-background-radius: 8;
                        -fx-border-radius: 8;
                        -fx-border-color: #bdc3c7;
                        -fx-padding: 5 10;
                    </style>
                </TextField>

                <!-- Action Buttons -->
                <Button layoutX="50.0" layoutY="163.0" onAction="#onGenerate" prefHeight="41.0" prefWidth="238.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 8;" text="Generate Edit Distance Table">
                    <font>
                        <Font name="Segoe UI" />
                    </font>
                </Button>

                <Button layoutX="320.0" layoutY="163.0" onAction="#extractOperations" prefHeight="41.0" prefWidth="168.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 8;" text="Trace Operations">
                    <font>
                        <Font name="Segoe UI" />
                    </font>
                </Button>

                <!-- Results Panel -->
                <Label layoutX="690.0" layoutY="26.0" prefHeight="38.0" prefWidth="150.0" style="-fx-font-size: 14; -fx-text-fill: #2c3e50;" text="Edit Distance:" />

                <Label fx:id="resultLabel" layoutX="808.0" layoutY="26.0" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #e74c3c; -fx-padding: 5 10; -fx-background-color: #ecf0f1; -fx-background-radius: 6; -fx-border-color: #bdc3c7; -fx-border-width: 1;" text="computing.." />

                <Label layoutX="1234.0" layoutY="12.0" prefHeight="35.0" prefWidth="120.0" style="-fx-font-size: 14; -fx-text-fill: #2c3e50;" text="Operation:" />

                <Label fx:id="comparison" layoutX="1163.0" layoutY="66.0" prefHeight="135.0" prefWidth="262.0" style="-fx-font-size: 13; -fx-text-fill: #7f8c8d; -fx-padding: 10; -fx-background-color: #ffffff; -fx-border-color: #dce0e4; -fx-border-width: 1; -fx-background-radius: 6;" text="Ready to compute..." wrapText="true" />

                <Label alignment="CENTER" layoutX="705.0" layoutY="107.0" prefHeight="38.0" prefWidth="60.0" style="-fx-font-size: 14; -fx-text-fill: #2c3e50;" text="Steps:" textAlignment="CENTER" />

                <Label fx:id="answer1" alignment="CENTER" layoutX="795.0" layoutY="91.0" prefHeight="41.0" prefWidth="231.0" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #27ae60; -fx-padding: 5 10; -fx-background-color: #ecf0f1; -fx-background-radius: 6; -fx-border-color: #bdc3c7; -fx-border-width: 1;" text="computing.." />
            <Label fx:id="answer2" alignment="CENTER" layoutX="795.0" layoutY="143.0" prefHeight="41.0" prefWidth="231.0" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #27ae60; -fx-padding: 5 10; -fx-background-color: #ecf0f1; -fx-background-radius: 6; -fx-border-color: #bdc3c7; -fx-border-width: 1;" text="computing.." />

            </children>
        </Pane>

        <!-- Table Title -->
        <Label layoutX="50.0" layoutY="210.0" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="DP Table Visualization" />

        <!-- Drawing Pane -->
        <Pane fx:id="drawingPane" layoutX="50.0" layoutY="240.0" prefHeight="510.0" prefWidth="1400.0" style="-fx-background-color: #ffffff; -fx-border-color: #bdc3c7; -fx-border-width: 2; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 0);" />

    </children>
</AnchorPane>
