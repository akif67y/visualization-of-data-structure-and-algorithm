<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="444.0" prefWidth="674.0" spacing="20.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Button onAction="#onHelloButtonClick" prefHeight="45.0" prefWidth="280.0" text="DATA  STRUCTURE AND ALGORITHM SIMULATOR" textAlignment="CENTER" textFill="#0b07df" wrapText="true" />
   <Button alignment="CENTER" mnemonicParsing="false" onAction="#StackButtonClick" onMouseClicked="#StackButtonClick" prefHeight="43.0" prefWidth="79.0" text="STACK" />

    <Label fx:id="welcomeText" />
   <Button mnemonicParsing="false" prefHeight="41.0" prefWidth="79.0" text="SORTING" />
   <ButtonBar prefHeight="38.0" prefWidth="258.0" />
   <Button mnemonicParsing="false" prefHeight="46.0" prefWidth="75.0" text="QUEUE" translateY="-20.0" />
</VBox>
