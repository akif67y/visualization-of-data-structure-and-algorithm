<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="800.0" prefWidth="1500.0" style="-fx-background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.stack.StackController">
    <children>
      <Text fx:id="status" layoutX="127.0" layoutY="127.0" strokeType="OUTSIDE" strokeWidth="0.0" text="X : ? , Y : ?" wrappingWidth="170.13673400878906">
         <font>
            <Font size="34.0" />
         </font></Text>
        <!-- Title -->
        <Label layoutX="515.0" layoutY="14.0" text="Stack Visualizer" textFill="#181373">
            <font>
                <Font name="System Bold" size="32.0" />
            </font>
        </Label>
      <VBox layoutX="1129.0" layoutY="21.0" prefHeight="584.0" prefWidth="350.0" style="-fx-background-color: rgba(255, 255, 255, 0.15); -fx-background-radius: 20; -fx-padding: 20;">
         <children>
            <HBox alignment="CENTER" prefHeight="50.0">
               <children>
                  <Label text="Stack Visualization" textFill="#a128d9">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <VBox alignment="BOTTOM_CENTER" prefHeight="724.0" prefWidth="324.0" style="-fx-background-color: rgba(255, 255, 255, 0.1); -fx-background-radius: 15; -fx-padding: 15;">
               <children>
                  <Label text="── STACK BASE ──" textFill="#a128d999">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <VBox fx:id="buttonContainer" alignment="BOTTOM_CENTER" spacing="5.0">
                     <VBox.margin>
                        <Insets bottom="10.0" top="10.0" />
                     </VBox.margin>
                  </VBox>
                  <Label text="↑ TOP" textFill="#a128d9">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </children>
      </VBox>

        <!-- Control Panel -->
        <VBox layoutX="557.0" layoutY="90.0" prefHeight="400.0" prefWidth="300.0" spacing="25.0" style="-fx-background-color: rgba(255, 255, 255, 0.1); -fx-background-radius: 20; -fx-padding: 30;">
            <children>
                <!-- Input Section -->
                <VBox spacing="10.0">
                    <children>
                        <Label text="Enter Value:" textFill="#181373">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <TextField fx:id="inputField" onKeyPressed="#handleTextFieldKeyPressed" prefHeight="45.0" promptText="Input a Number" style="-fx-background-color: rgba(255, 255, 255, 0.9); -fx-background-radius: 10; -fx-padding: 0 15; -fx-font-size: 14px; -fx-border-color: transparent; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </TextField>
                    </children>
                </VBox>

                <!-- Buttons Section -->
                <VBox spacing="15.0">
                    <children>
                        <Button fx:id="pushbutton" mnemonicParsing="false" onAction="#onAddClicked" prefHeight="50.0" prefWidth="240.0" style="-fx-background-color: #4CAF50; -fx-background-radius: 15; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 8, 0, 0, 3); -fx-cursor: hand;" text="🔼 PUSH">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Button>

                        <Button mnemonicParsing="false" onAction="#poppedCalled" prefHeight="50.0" prefWidth="240.0" style="-fx-background-color: #f44336; -fx-background-radius: 15; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 8, 0, 0, 3); -fx-cursor: hand;" text="🔽 POP">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Button>
                    </children>
                </VBox>

                <!-- Stack Info -->
                <VBox spacing="10.0">
                    <children>
                        <Label text="Stack Operations:" textFill="#181373">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <Label text="• PUSH: Add element to top" textFill="#181373cc">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                        <Label text="• POP: Remove top element" textFill="#181373cc">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </VBox>

        <!-- Linked List Representation -->
        <VBox layoutX="2.0" layoutY="456.0" onMouseClicked="#displaypos" onMouseDragged="#displaypos" prefHeight="334.0" prefWidth="1119.0" style="-fx-background-color: rgba(255, 255, 255, 0.15); -fx-background-radius: 20; -fx-padding: 20;">
            <children>
                <!-- Linked List Title -->
                <HBox alignment="CENTER" prefHeight="30.0" />

                <!-- Linked List Container -->
                <AnchorPane fx:id="linkedListContainer" onMouseClicked="#displaypos" onMouseMoved="#displaypos" onMousePressed="#displaypos" prefHeight="350.0" prefWidth="1215.0" style="-fx-background-color: rgba(255, 255, 255, 0.1); -fx-background-radius: 15; -fx-padding: 15;">
                    <children>
                        <!-- HEAD Label -->
                        <Label layoutX="10.0" layoutY="10.0" text="HEAD →" textFill="#FFD700">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>

                        <!-- NULL Label (initially visible) -->
                        <Label fx:id="nullLabel" layoutX="70.0" layoutY="60.0" text="NULL" textFill="#18137399">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                    </children>
                </AnchorPane>
            </children>
        </VBox>
            <Label layoutX="112.0" layoutY="325.0" text="Linked List Representation" textFill="#181373">
                <font>
                    <Font name="System Bold" size="16.0" />
                </font>
            </Label>
    </children>
</AnchorPane>
