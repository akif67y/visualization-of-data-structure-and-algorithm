<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.StackController">
   <children>
      <AnchorPane layoutX="222.0" layoutY="125.0" prefHeight="189.0" prefWidth="346.0">
         <children>
            <ButtonBar layoutX="-21.0" prefHeight="40.0" prefWidth="143.0" />
            <VBox fx:id="buttonContainer" layoutX="68.0" layoutY="25.0" prefHeight="207.0" prefWidth="278.0" />
         </children>
      </AnchorPane>
      <ButtonBar layoutX="72.0" layoutY="31.0" prefHeight="40.0" prefWidth="200.0">
        <buttons>
          <Button fx:id="pushbutton" alignment="CENTER" mnemonicParsing="false" onAction="#onAddClicked" onMouseClicked="#onAddClicked" prefHeight="34.0" prefWidth="158.0" text="PUSH" translateX="-20.0" />
        </buttons>
      </ButtonBar>
    <Button layoutX="90.0" layoutY="93.0" mnemonicParsing="false" onAction="#onAddClicked" onMouseClicked="#poppedCalled" prefHeight="32.0" prefWidth="162.0" text="POP" />
      <TextField fx:id="inputField" layoutX="100.0" layoutY="159.0" onKeyPressed="#handleTextFieldKeyPressed" prefHeight="34.0" prefWidth="134.0" promptText="Input a Number">
         <font>
            <Font size="14.0" />
         </font>
      </TextField>
   </children>
</AnchorPane>
